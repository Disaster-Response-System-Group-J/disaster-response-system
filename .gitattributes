# Line ending normalization for cross-platform Docker compatibility
# Ensure shell scripts and configs use LF (Unix) not CRLF (Windows)
* text=auto
*.sh eol=lf
*.bash eol=lf
*.env eol=lf
*.yml eol=lf
*.yaml eol=lf
*.json eol=lf
*.sql eol=lf

# GitHub Linguist overrides
.next/** linguist-generated=true
dist/** linguist-generated=true
build/** linguist-generated=true
node_modules/** linguist-vendored=true
*.lock linguist-generated=true
local_alerts.db binary
