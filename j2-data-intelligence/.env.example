# J2 Data & Intelligence Environment Configuration

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/j2_data_intelligence
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=j2_data_intelligence
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ============================================
# Kafka Configuration
# ============================================
# For Docker Compose: use service name 'kafka'
# For local development: use 'localhost:9092'
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC_SENSOR=j1.sensor.telemetry
KAFKA_TOPIC_RISK_ALERTS=j2.engine.risk-alerts
KAFKA_CONSUMER_GROUP=j2-sensor-consumer

# ============================================
# Service Configuration
# ============================================
SERVICE_NAME=j2-data-intelligence
SERVICE_VERSION=2.0.0
HOST=0.0.0.0
PORT=8082

# ============================================
# ML Model Configuration
# ============================================
MODEL_PATH=app/models/
PREDICTION_INTERVAL_SECONDS=3600

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
