// Database Schema Definition (Prisma Format)
// This documents the expected data models for J3 operations.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// Users & Roles
// ------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(PUBLIC_USER)
  createdAt DateTime @default(now())

  reviewedReports IncomingReport[] @relation("ReviewedBy")
}

enum Role {
  PUBLIC_USER
  INCIDENT_COMMANDER_NATIONAL
  INCIDENT_COMMANDER_ZONAL
  OPERATIONS_OFFICER_NATIONAL
  OPERATIONS_OFFICER_ZONAL
  RESOURCE_MANAGER_NATIONAL
  RESOURCE_MANAGER_ZONAL
  SYSTEM_ADMIN
}

// ------------------------------------------------------
// Incidents & Reports
// ------------------------------------------------------
model IncomingReport {
  id                 String             @id @default(uuid())
  source             ReportSource
  disasterType       DisasterType
  district           String
  latitude           Float
  longitude          Float
  description        String
  contact            String?
  mediaUrls          String[]
  verificationStatus VerificationStatus @default(PENDING_REVIEW)
  createdAt          DateTime           @default(now())

  // External IDs
  sosId              String?
  deviceId           String?

  // Review tracking
  officerNotes       String?
  reviewedById       String?
  reviewedBy         User?              @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?

  // Relation to confirmed incident
  incidentId         String?
  incident           ConfirmedIncident? @relation(fields: [incidentId], references: [id])
}

model ConfirmedIncident {
  id               String           @id @default(uuid())
  title            String
  disasterType     DisasterType
  district         String
  severity         IncidentSeverity
  status           IncidentStatus   @default(ACTIVE)
  latitude         Float
  longitude        Float
  description      String
  publicVisibility Boolean          @default(true)
  affectedPeople   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  sourceReports    IncomingReport[]
  assignedResources Resource[]
}

enum ReportSource {
  J1_SOS_APP
  J3_PUBLIC_PORTAL
  J1_SENSOR_SYSTEM
  WEATHER_API
  OFFICER_CREATED
}

enum VerificationStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  DUPLICATE
  CONVERTED_TO_INCIDENT
}

enum DisasterType {
  FLOOD
  LANDSLIDE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  UNDER_RESPONSE
  RESOLVED
  CLOSED
}

// ------------------------------------------------------
// Resources
// ------------------------------------------------------
model Resource {
  id           String         @id @default(uuid())
  type         ResourceType
  name         String
  district     String
  status       ResourceStatus @default(AVAILABLE)
  latitude     Float?
  longitude    Float?
  capacity     Int?
  currentLoad  Int?
  lastUpdated  DateTime       @default(now())

  incidentId   String?
  incident     ConfirmedIncident? @relation(fields: [incidentId], references: [id])
}

enum ResourceType {
  RESCUE_TEAM
  BOAT
  AMBULANCE
  SHELTER
  MEDICAL_TEAM
  FOOD_WATER
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  BUSY
  OUT_OF_SERVICE
}

// ------------------------------------------------------
// Alerts
// ------------------------------------------------------
model Alert {
  id          String           @id @default(uuid())
  type        AlertType
  severity    IncidentSeverity
  title       String
  description String
  district    String
  isPublic    Boolean          @default(false)
  isActive    Boolean          @default(true)
  source      String?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime?
}

enum AlertType {
  RISK_ALERT
  PUBLIC_ALERT
  SHELTER_CAPACITY
  RESOURCE_SHORTAGE
  INCIDENT_STATUS
}

// ------------------------------------------------------
// Division & IoT Devices
// ------------------------------------------------------
model Division {
  divisionId       Int     @id @default(autoincrement()) @map("division_id")
  locationId       Int?    @unique @map("location_id")
  name             String  @unique @map("division_name")
  district         String?
  province         String?
  latitude         Float?
  longitude        Float?
  divisionPopulation Int?   @map("division_population")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  iotDevices          IoT_Device[]
  rainfallData        RainfallData[]
  soilMoisture        SoilMoisture[]
  temperatureData     TemperatureData[]
  disasterRisk        DisasterRisk[]
  computedFeatures    ComputedFeatures[]
  forecastWeather     ForecastWeatherData[]
  forecastFeatures    ForecastFeatures[]
  disasterPredictions DisasterPrediction[]
}

model IoT_Device {
  deviceId         String   @id @map("device_id")
  divisionId       Int      @map("division_id")
  installationDate DateTime? @map("installation_date")
  status           String?

  division        Division @relation(fields: [divisionId], references: [divisionId])
  baseWaterLevel  BaseWaterLevel?
  floodSeverity   FloodSeverity[]
}

model BaseWaterLevel {
  deviceId    String   @id @map("device_id")
  baseLevel   Float    @map("base_level")
  setDate     DateTime? @map("set_date")

  device IoT_Device @relation(fields: [deviceId], references: [deviceId])
}

model FloodSeverity {
  severityId  Int      @id @default(autoincrement()) @map("severity_id")
  deviceId    String   @map("device_id")
  timestamp   DateTime?
  currentLevel Float?  @map("current_level")
  baseLevel   Float?   @map("base_level")
  difference  Float?
  severity    String?

  device IoT_Device @relation(fields: [deviceId], references: [deviceId])
}

// ------------------------------------------------------
// Weather Data from OpenMeteO
// ------------------------------------------------------
model RainfallData {
  rainfallId  Int      @id @default(autoincrement()) @map("rainfall_id")
  divisionId  Int      @map("division_id")
  date        DateTime @map("date") @db.Date
  rainSum     Float?   @map("rain_sum")

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, date])
}

model SoilMoisture {
  soilId              Int      @id @default(autoincrement()) @map("soil_id")
  divisionId          Int      @map("division_id")
  date                DateTime @map("date") @db.Date
  moisture_7_28cm     Float?   @map("moisture_7_28cm")
  moisture_28_100cm   Float?   @map("moisture_28_100cm")
  moisture_100_255cm  Float?   @map("moisture_100_255cm")

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, date])
}

model TemperatureData {
  tempId      Int      @id @default(autoincrement()) @map("temp_id")
  divisionId  Int      @map("division_id")
  date        DateTime @map("date") @db.Date
  temperature Float?

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, date])
}

model DisasterRisk {
  riskId      Int     @id @default(autoincrement()) @map("risk_id")
  divisionId  Int?    @map("division_id")
  date        DateTime @map("date") @db.Date
  disasterType String? @map("disaster_type")
  riskLevel   String? @map("risk_level")
  score       Float?

  division Division? @relation(fields: [divisionId], references: [divisionId])
}

// ------------------------------------------------------
// Computed ML Features (derived from raw weather data)
// ------------------------------------------------------
model ComputedFeatures {
  featureId       Int      @id @default(autoincrement()) @map("feature_id")
  divisionId      Int      @map("division_id")
  date            DateTime @map("date") @db.Date
  rainLag1        Float?   @map("rain_lag_1")
  rainRolling3d   Float?   @map("rain_rolling_3d")
  rainRolling7d   Float?   @map("rain_rolling_7d")
  monthSin        Float?   @map("month_sin")
  monthCos        Float?   @map("month_cos")
  spi             Float?
  divisionEncoded Int?     @map("division_encoded")

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, date])
  @@map("computed_features")
}

// ------------------------------------------------------
// Forecast Raw Weather Data (Open-Meteo future predictions)
// ------------------------------------------------------
model ForecastWeatherData {
  forecastId       Int      @id @default(autoincrement()) @map("forecast_id")
  divisionId       Int      @map("division_id")
  date             DateTime @map("date") @db.Date
  rainSum          Float?   @map("rain_sum")
  temperature      Float?
  moisture7_28cm   Float?   @map("moisture_7_28cm")
  moisture28_100cm Float?   @map("moisture_28_100cm")
  moisture100_255cm Float?  @map("moisture_100_255cm")
  fetchedAt        DateTime @default(now()) @map("fetched_at")

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, date])
  @@map("forecast_weather_data")
}

// ------------------------------------------------------
// Forecast Computed ML Features (derived from forecast raw data)
// ------------------------------------------------------
model ForecastFeatures {
  featureId       Int      @id @default(autoincrement()) @map("feature_id")
  divisionId      Int      @map("division_id")
  date            DateTime @map("date") @db.Date
  rainLag1        Float?   @map("rain_lag_1")
  rainRolling3d   Float?   @map("rain_rolling_3d")
  rainRolling7d   Float?   @map("rain_rolling_7d")
  monthSin        Float?   @map("month_sin")
  monthCos        Float?   @map("month_cos")
  spi             Float?
  divisionEncoded Int?     @map("division_encoded")

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, date])
  @@map("forecast_features")
}

// ------------------------------------------------------
// ML Disaster Predictions (derived from forecast_features + forecast_weather_data)
// ------------------------------------------------------
model DisasterPrediction {
  predictionId          Int      @id @default(autoincrement()) @map("prediction_id")
  divisionId            Int      @map("division_id")
  featureDate           DateTime @map("feature_date") @db.Date
  predictedForDate      DateTime @map("predicted_for_date") @db.Date
  horizon               Int
  hazardType            String   @map("hazard_type")
  probNormal            Float?   @map("prob_normal")
  probModerate          Float?   @map("prob_moderate")
  probSevere            Float?   @map("prob_severe")
  probExtreme           Float?   @map("prob_extreme")
  predictedSeverity     Int?     @map("predicted_severity")
  predictedSeverityLabel String? @map("predicted_severity_label")
  runAt                 DateTime @default(now()) @map("run_at")

  division Division @relation(fields: [divisionId], references: [divisionId])

  @@unique([divisionId, featureDate, hazardType, horizon])
  @@map("disaster_predictions")
}

// ------------------------------------------------------
// SPI Data (for drought monitoring)
// ------------------------------------------------------
model SPI_Data {
  spiId      Int     @id @default(autoincrement()) @map("spi_id")
  divisionId Int     @map("division_id")
  date       DateTime @map("date") @db.Date
  spiValue   Float?  @map("spi_value")
  timescale  Int     @map("timescale")

  @@unique([divisionId, date, timescale])
}
