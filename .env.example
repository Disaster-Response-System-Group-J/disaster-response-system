# Local development/demo environment.
# Copy this file to .env before running docker compose.
# These values are safe demo placeholders only. Do not use them in production.

# PostgreSQL superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DisasterMangementSystem@j2
POSTGRES_DB=postgres

# PostgreSQL - J3 service account
# Used by postgres/init.sh to create the J3 database.
J3_DB_USER=j3user
J3_DB_PASSWORD=j3pass
J3_DB_NAME=j3db

# PostgreSQL - Kong service account
# Used by kong-migration and kong.
KONG_DB_USER=kong
KONG_DB_PASSWORD=kongpass
KONG_DB_NAME=kong

# PostgreSQL - Keycloak service account
# Used by the keycloak container.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloakpass

# Keycloak admin
# Used by keycloak and keycloak-setup.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Kong JWT issuer URL
# For local Docker Compose, users mint tokens through host port 8180.
KC_ISSUER=http://localhost:8180/realms/disaster-response

# HashiCorp Vault dev mode
# Used by vault, vault-setup, and keycloak-setup.
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token

# Internal service token
# Used by J1/J2 services when those containers are included.
INTERNAL_SERVICE_TOKEN=local-internal-token

# Monitoring
GF_SECURITY_ADMIN_PASSWORD=admin123
ALERTMANAGER_EMAIL_PASSWORD=dummy-email-password

# ELK log retention
ELK_LOG_RETENTION_DAYS=14

# J1 - MQTT credentials
# Dummy values are enough if you are not starting J1 MQTT services.
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=local-mqtt-user
MQTT_PASSWORD=local-mqtt-password

# J3 - public URLs used as Next.js build args
SERVER_IP=localhost

# J4 - blockchain audit
# Default mode is Sepolia. Fill these manually; never commit real secrets.
# For local Hardhat mode, set BLOCKCHAIN_NETWORK=local and
# BLOCKCHAIN_RPC_URL=http://hardhat-node:8545.
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=
AUDIT_CONTRACT_ADDRESS=
AUDIT_PRIVATE_KEY=
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# J4 - audit dashboard API target
# Direct local mode: http://localhost:8084/api/v1/audit
# Kong gateway mode: http://localhost:8000/api/v1/audit
NEXT_PUBLIC_AUDIT_API_BASE_URL=http://localhost:8084/api/v1/audit

# Supabase REST / optional external persistence
# Leave blank for local Compose unless a service explicitly needs them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional direct Postgres connection string for services that support it.
# Leave blank unless you want a service to connect using one URL.
DATABASE_URL=postgresql://postgres:DisasterMangementSystem%40j2@db.qfhmczryyyddgitnlndy.supabase.co:5432/postgres

# J2 - Gemini API
# Dummy value is enough if you are not testing Gemini-backed J2 features.
GEMINI_API_KEY=local-gemini-placeholder
