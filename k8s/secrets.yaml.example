# Copy this file to k8s/secrets.yaml, fill in real values, then apply with:
#   kubectl apply -f k8s/secrets.yaml
#
# k8s/secrets.yaml is gitignored — never commit real credentials to git.
apiVersion: v1
kind: Secret
metadata:
  name: disaster-secrets
  namespace: disaster-response
type: Opaque
stringData:
  # ── PostgreSQL superuser ─────────────────────────────────────────────────────
  POSTGRES_USER: disaster
  POSTGRES_PASSWORD: CHANGE_ME
  POSTGRES_DB: disasterdb

  # ── PostgreSQL — J3 service account ─────────────────────────────────────────
  J3_DB_USER: j3user
  J3_DB_PASSWORD: CHANGE_ME
  J3_DB_NAME: j3db
  J3_DATABASE_URL: postgresql://j3user:CHANGE_ME@postgres:5432/j3db

  # ── PostgreSQL — J2 service account ─────────────────────────────────────────
  J2_DATABASE_URL: postgresql://disaster:CHANGE_ME@postgres:5432/disasterdb

  # ── PostgreSQL — Kong service account ───────────────────────────────────────
  KONG_DB_USER: kong
  KONG_DB_PASSWORD: CHANGE_ME
  KONG_DB_NAME: kong

  # ── PostgreSQL — Keycloak service account ────────────────────────────────────
  KC_DB_USERNAME: keycloak
  KC_DB_PASSWORD: CHANGE_ME

  # ── Keycloak admin ───────────────────────────────────────────────────────────
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: CHANGE_ME

  # Kong JWT issuer — must match the `iss` claim in tokens.
  # In-cluster Keycloak address (not the host-port alias):
  KC_ISSUER: http://keycloak:8080/realms/disaster-response

  # ── Grafana ──────────────────────────────────────────────────────────────────
  GF_SECURITY_ADMIN_PASSWORD: CHANGE_ME

  # ── J1 — MQTT credentials ────────────────────────────────────────────────────
  MQTT_BROKER: CHANGE_ME
  MQTT_PORT: "8883"
  MQTT_USERNAME: j1_gateway
  MQTT_PASSWORD: CHANGE_ME

  # ── J3 — Public URLs ─────────────────────────────────────────────────────────
  # Set to the externally reachable address of j3-dms (NodePort / ingress host).
  NEXT_PUBLIC_API_URL: http://CHANGE_ME:3000

  # ── J3 — Supabase (if used; set to empty string if not) ─────────────────────
  NEXT_PUBLIC_SUPABASE_URL: ""
  NEXT_PUBLIC_SUPABASE_ANON_KEY: ""
  SUPABASE_SERVICE_ROLE_KEY: ""

  # ── J4 — Blockchain audit ────────────────────────────────────────────────────
  # Default is Hardhat account #0 test key — safe for dev ONLY.
  AUDIT_PRIVATE_KEY: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
