# J4 Blockchain Audit API
PORT=8084

# Active/default mode: Sepolia testnet.
# Use an RPC URL from Alchemy, Infura, QuickNode, or another Sepolia RPC provider.
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=

# Address of the IncidentAuditLog contract deployed on Sepolia.
AUDIT_CONTRACT_ADDRESS=

# Backend wallet private key. This wallet sends audit transactions and needs Sepolia ETH.
# Never commit a real private key.
AUDIT_PRIVATE_KEY=

# Optional aliases used by Hardhat when deploying to Sepolia.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Local Hardhat development example:
# BLOCKCHAIN_NETWORK=local
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# AUDIT_CONTRACT_ADDRESS=
# AUDIT_PRIVATE_KEY=
